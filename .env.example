DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_VOLUME_FILES=/Volumes/dev/raw/landing

# One deployment = one Study (FR-017). All studies share the Volume root
# <DATABRICKS_VOLUME_FILES>/text_cluster_validation/; this deployment writes everything under
# text_cluster_validation/${STUDY_ID}/. STUDY_ID MUST match the studyId inside study.json.
# Run a second concurrent study by deploying another app with a different STUDY_ID (its own URL).
STUDY_ID=study-002

# STUDY_OWNER_IDS=alice@org,bob@org   # only if the optional admin export route is built

# App-wide UI language for built-in strings (buttons, prompts, system messages, the default
# welcome copy). One of `nl` or `en`; defaults to `en` when unset or invalid. Not per-study and
# not participant-selectable. Never translates researcher-authored content or task items (FR-013–FR-015).
SURVEY_LANGUAGE=nl

DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=clustering-app
